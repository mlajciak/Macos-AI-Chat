{
  "id": "oel-two-file-bracket-transcript",
  "description": "Two-file bracket: validate and orient gates before patch_file on touched CAD",
  "steps": [
    { "tool": "get_capabilities", "expectGate": null },
    { "tool": "validate_script", "args": { "fileName": "bracket.xyzt" }, "expectOk": true },
    { "tool": "orient_cad", "args": { "fileName": "bracket.xyzt" }, "expectOk": true },
    { "tool": "patch_file", "args": { "fileName": "bracket.xyzt" }, "expectAllowed": true },
    { "tool": "update_overview", "expectAllowed": false, "expectCode": "WORKFLOW_VALIDATE_REQUIRED" }
  ]
}
